# ─────────────────────────────────────────────────────────────
# Boxing Center — variables d'environnement (Vercel → Settings → Environment Variables)
# TOUTES sont optionnelles : sans elles le site fonctionne, en mode dégradé honnête.
# Copie ce fichier en .env pour du local. NE COMMITE JAMAIS .env.
# ─────────────────────────────────────────────────────────────

# ── Le backoffice « Le vestiaire » (/admin/) ──
# Le mot de passe du staff. Sans lui, l'admin refuse toute connexion.
ADMIN_TOKEN=

# ── L'assistant (chatbot IA) ──
# Au moins UNE clé pour des réponses IA. Sans aucune, l'assistant répond
# quand même via sa base locale ancrée (jamais de bulle vide).
# GEMINI est lu en POOL : tu peux ajouter GEMINI_API_KEY_2, _3, … pour répartir le quota.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Avis Google (SEO/GEO) ──
# Facultatif. Avec cette clé, le build vérifie la fiche Minimes dans
# Google Places (New) avant d'afficher une note. Sans clé ou si Google
# refuse la requête, aucune note agrégée périmée n'est publiée.
GOOGLE_PLACES_API_KEY=

# Délai maximal par fournisseur IA. Une clé expirée ne doit pas bloquer
# la réponse locale du chatbot. Valeur bornée côté serveur à 2–20 s.
CHAT_PROVIDER_TIMEOUT_MS=8000

# ── Les contacts collectés par l'assistant ──
# Option A — le registre relisible dans le vestiaire (recommandé) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B — un e-mail au staff à chaque contact :
RESEND_API_KEY=
LEAD_TO=boxingcenter31@gmail.com
LEAD_FROM=
# Option C — un webhook (Make, Zapier, n8n…) :
LEAD_WEBHOOK_URL=
# Sans aucune option, les contacts sont journalisés dans les logs Vercel (rien n'est perdu).

# ── La galerie du club (dépôts des visiteurs sur /galerie/) ──
# UNE seule variable : Cloudinary sert de stockage, de transcodage, de base
# (l'état vit dans les tags) et de modération. Copie l'« API Environment
# variable » depuis ton dashboard Cloudinary — elle a cette forme :
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Sans elle, la section reste fermée proprement : aucun dépôt, aucun cadre vide.
CLOUDINARY_URL=
# Le dossier de CETTE salle — chaque salle a le sien, les murs ne se mélangent pas.
# Les deux noms sont lus (COMMUNITY_FOLDER d'abord) : c'est le même réglage.
COMMUNITY_FOLDER=bc-minimes-community
# CLOUDINARY_FOLDER=bc-minimes-community
# L'ŒIL DE LA MACHINE sur les photos déposées : ce sont les MÊMES clés
# GEMINI_API_KEY* que l'assistant (lues en pool, plus haut) — rien à
# ajouter. Avant qu'une photo ne parte chez Cloudinary, le modèle regarde
# ce qu'il y a dessus et écarte l'évident : nudité, violence, capture
# d'écran, mème, hors sujet total. Dans le doute il laisse passer.
# SANS CLÉ, RIEN NE CASSE : tout part en file de modération humaine,
# exactement comme avant, et le vestiaire l'affiche honnêtement
# (« Non filtré — à toi de regarder »).
# Les vidéos ne passent jamais par là : un outil qui regarde des images
# fixes n'analyse pas une vidéo. Elles vont droit à la file humaine.
# GEMINI_VISION_MODEL=gemini-2.5-flash   # par défaut : GEMINI_MODEL
# VISION_TIMEOUT_MS=8000

# Modération automatique — nécessite l'add-on Cloudinary correspondant.
# Vide = tout part en file de modération humaine (dégradation honnête).
#   images : aws_rek        · vidéos : google_video_moderation
CLOUDINARY_MODERATION=
# Les limites annoncées au visiteur ET vérifiées côté navigateur.
COMMUNITY_MAX_MB=60
COMMUNITY_MAX_SEC=15
# Limite de dépôts par IP (partagée avec le reste des fonctions).
RATE_WINDOW_MIN=10
RATE_MAX=3

# ── Publication depuis le vestiaire (bouton « Publier ») ──
# Le backoffice commite le contenu sur GitHub puis redéclenche le déploiement.
GITHUB_TOKEN=
GITHUB_REPO=Eddy-etame/Bc-minimes
GITHUB_BRANCH=main
VERCEL_DEPLOY_HOOK=
