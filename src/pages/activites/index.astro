  <!-- page-scoped : sommaire ancré + rangées disciplines (un écran/discipline,
       jamais une grille de carrés — c’est un catalogue qui se déroule) -->
  <style is:inline>
    /* l’en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : le sommaire ancré, qui colle sous la
       nav et suit la lecture. */
    /* sommaire — chips ancrées, colle sous la nav au scroll */
    /* Barre de sommaire collante. Son fond était un noir à 82 % écrit en
       dur — pensé pour la page sombre de v3. Sur la page blanche il
       formait un bandeau opaque portant des pastilles au texte navy :
       2.42:1. Il devient un verre CLAIR, cohérent avec la barre de
       navigation qui se fige juste au-dessus. */
    .act-index { position: sticky; top: 0; z-index: 20; display: flex; flex-wrap: wrap; gap: .5rem; padding: clamp(.8rem,2vw,1.1rem) 0; background: rgba(255,255,255,.9); backdrop-filter: blur(12px) saturate(1.3); border-bottom: 1px solid var(--hair); }
    .act-chip { display: inline-flex; align-items: center; gap: .7ch; min-height: 44px; padding: .55em .95em; border: 1px solid var(--line); font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--bone-dim); transition: color .3s, border-color .3s, background .3s; }
    .act-chip__n { color: var(--bone-dim); }
    .act-chip:hover, .act-chip:active { color: #fff; background: var(--navy-600); border-color: var(--navy-600); }
    .act-chip:hover .act-chip__n, .act-chip:active .act-chip__n { color: var(--bone-dim); }

    /* rangée discipline */
    .act-rows { border-top: 0; }
    .act { position: relative; display: grid; grid-template-columns: 1fr; gap: clamp(1.6rem,4vw,3.5rem); align-items: center; padding-block: clamp(3rem,7vw,5.5rem); border-bottom: 1px solid var(--line); scroll-margin-top: 5.5rem; }
    .act > * { min-width: 0; }   /* grid children must be shrinkable (no overflow) */
    @media (min-width: 900px){ .act { grid-template-columns: 1.05fr 1fr; } .act--rev .act__media { order: 2; } }
    /* align-self:start — NOT stretch: a stretched (tall) height + aspect-ratio
       would derive a width wider than the column → 1280px horizontal scroll */
    .act__media { position: relative; aspect-ratio: 4/3; align-self: start; min-height: 15rem; }
    .act__media img { filter: grayscale(1) contrast(1.2) brightness(.8); object-position: 50% 30%; transition: filter .6s var(--ease), transform 1s var(--ease-out); transform: scale(1.03); }
    .act:hover .act__media img, .act:active .act__media img { filter: grayscale(1) contrast(1.1) brightness(.95); transform: scale(1); }
    .act__body { position: relative; }
    .act__bigidx { position: absolute; top: -2.4rem; right: 0; font-family: var(--f-display); font-size: clamp(4rem,11vw,9rem); line-height: .8; color: transparent; -webkit-text-stroke: 1.5px var(--line); pointer-events: none; z-index: 0; }
    .act__tag { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone); }
    .act__tag::before { content: ""; width: 18px; height: 2px; background: var(--mark); flex: 0 0 18px; }
    .act__name { position: relative; z-index: 1; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2rem,5.5vw,4rem); line-height: .92; margin: .7rem 0 1rem; color: var(--bone); }

    /* le badge créneaux — DÉRIVÉ de PLANNING (voir activites.js). Deux
       états, tous les deux assumés : « N créneaux » quand le poster le
       prouve, « en accès libre » quand il ne le prouve pas. Le second
       n’est pas un manque à cacher, c’est une info que le visiteur
       cherche — d’où le même poids typographique, un filet en moins. */
    .act__slots { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: .7ch; margin-bottom: 1.1rem; padding: .45em .9em; border: 1px solid var(--line); border-left: 3px solid var(--mark); font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); }
    .act__slots b { color: var(--bone); font-weight: 700; }
    .act__slots--free { border-left-style: dashed; color: var(--read); font-weight: 500; }

    /* pas de photo pour ce geste → tuile dessinée, jamais une image
       empruntée (même loi que le roster des coachs sans portrait) */
    .act__media--none { position: relative; aspect-ratio: 4/3; align-self: start; min-height: 15rem; display: grid; place-content: center; gap: .8rem; justify-items: center; background: var(--paper-2); border: 1px solid var(--hair); border-radius: var(--radius-lg); overflow: hidden; }
    .act__media--none::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(120deg, #101830 0 9px, #17223c 9px 10px); opacity: .8; }
    .act__glyph { position: relative; font-family: var(--f-display); font-size: clamp(3.4rem,9vw,6rem); line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--line); }
    .act__nophoto { position: relative; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone-dim); border-top: 2px solid var(--mark); padding-top: .7rem; }
    .act__desc { position: relative; z-index: 1; font-size: var(--step-1); line-height: 1.4; color: var(--bone); font-weight: 500; max-width: 46ch; }
    .act__for { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1ch; margin: 1.4rem 0 1rem; color: var(--read); font-size: var(--step-0); }
