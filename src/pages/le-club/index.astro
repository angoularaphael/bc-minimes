<body data-page="le-club">
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label">voir</span></div></div>
  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= PAGE HEAD ======================== -->
    <header class="club-head">
      <div class="club-head__media"><div class="media" data-label="La salle des Minimes en activité"><img src="/assets/img/photos/minimes-salle-entrainement.webp" srcset="/assets/img/photos/minimes-salle-entrainement-800.webp 800w, /assets/img/photos/minimes-salle-entrainement.webp 1600w" sizes="100vw" width="1600" height="960" alt="Le plateau, les sacs et les pratiquants du Boxing Center Minimes à Toulouse." loading="eager" decoding="async" fetchpriority="high" /></div></div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="wrap club-head__inner">
        <p class="eyebrow" data-reveal>Le club · Les Minimes</p>
        <h1 class="club-head__title">
          <span class="reveal-mask"><span>La salle</span></span>
          <span class="reveal-mask"><span class="tint">historique.</span></span>
        </h1>
        <p class="lead" data-reveal style="max-width:48ch;margin-top:1.2rem">Celle par laquelle tout a commencé. Plusieurs rings, une odeur de cuir qui ne part pas, et 2016 dans les murs. Bienvenue au berceau.</p>
      </div>
      <div class="hero__foot" aria-hidden="true" style="z-index:4">
        <span class="scroll-cue">L’histoire <span class="line"></span></span>
      </div>
    </header>

    <!-- ========================= HISTOIRE ========================= -->
    <section class="section" aria-label="L’histoire de la salle">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Depuis 2016</span>
          <h2 class="display" style="margin-top:1rem">Une école, <span class="tint">une lignée</span></h2>
        </div>
        <ol class="timeline" id="timeline"></ol>
      </div>
    </section>

    <!-- ===================== AMBIANCE (parallax) ================== -->
    <section class="ambiance" aria-label="L’ambiance de la salle">
      <div class="ambiance__media" aria-hidden="true"><div class="media" data-img="/assets/img/photos/allee-sacs-1200.webp" data-label="Entre les cordes"></div></div>
      <div class="ambiance__quote wrap">
        <p class="serif" data-reveal>Philadelphie a ses salles. Toulouse a la sienne, au 12 rue de Fenouillet.<br>Les champions, eux, sont les mêmes : <span class="tint">bien réels.</span></p>
      </div>
    </section>

    <!-- ====================== ÉQUIPEMENT ========================= -->
    <section class="section" aria-label="L’équipement">
      <div class="wrap split">
        <div data-reveal>
          <span class="eyebrow">L’équipement</span>
          <h2 class="display" style="margin:1rem 0 1.4rem">Du matériel<br>de <span class="tint">boxeur.</span></h2>
          <p class="lead">Plusieurs rings, douze sacs lourds, une zone de pattes d’ours, la prépa à l’étage. Le matériel est usé : c’est le compliment.</p>
          <p class="muted" style="margin-top:1.2rem">Affilié FFBoxe · FFKMDA · FMMAF. Des coachs passés par l’amateur et la compétition avant de tenir les pattes.</p>
        </div>
        <div class="feature-card" id="specs" data-reveal></div>
      </div>
    </section>

    <!-- ROULETTE DES ABONNEMENTS — apres l equipement : il a vu ce qu il aura.
         Les deux offres phares y tournent en alternance ; le lien suit la
         case affichee. Montee par site.js > mountPromoWheels(). -->
    <div class="wrap" data-promo></div>


    <!-- ====================== ACCÈS / INFOS ====================== -->
    <section class="section band" aria-label="Accès et infos pratiques">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Infos pratiques</span>
          <h2 class="display" style="margin-top:1rem">Venir au <span class="tint">club</span></h2>
        </div>
        <!-- une seule ligne : le reste (horaires, accès, téléphone, FAQ) est
             sur /contact/. Deux pages qui répètent la même grille avec les
             mêmes ids, c’est une page de trop. -->
        <div class="contact-grid">
          <div data-reveal-group>
            <div class="contact-line"><span>Adresse</span><a id="addr" href="#" target="_blank" rel="noopener"></a></div>
            <div class="contact-line"><span>Le reste</span><p>Horaires, accès, téléphone et les questions qu’on nous pose : <a href="/contact/">tout est sur la page contact</a>.</p></div>
            <div class="contact-line"><a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=44-99-4-semaines&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Je m’inscris · 44,99€</span></a><a class="btn btn--ghost" data-magnetic href="https://boutique.boxingcenter.fr/seance-essai?utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Tester une séance · 10€</span></a></div>
          </div>
          <div class="map-frame" data-reveal>
            <iframe id="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte Boxing Center Minimes"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CE QU’ON DEMANDE EN POUSSANT LA PORTE =========
         Des questions de LIEU, propres à cette page — pas la FAQ de
         /contact/ recopiée. Prose, pas accordéon : une visite répond en
         marchant. -->
    <section class="section" aria-label="Ce qu’on demande en poussant la porte">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Sur le pas de la porte</span>
          <h2 class="display" style="margin-top:1rem">Ce qu’on demande <span class="tint">en entrant</span></h2>
        </div>
        <div class="asks" id="asks" data-reveal-group></div>
      </div>
    </section>

    <!-- ========================= LE RÉSEAU ======================= -->
    <section class="section" aria-label="Le réseau Boxing Center">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Le réseau</span>
          <h2 class="display" style="margin-top:1rem">Nos autres <span class="tint">salles</span></h2>
        </div>
        <div class="network" id="network" data-reveal-group></div>
      </div>
    </section>

    <!-- ===================== HEURE PAR HEURE ======================
         Ajout du 13/10/2026. La visite disait les murs ; elle dit
         maintenant ce qui s'y passe selon l'heure. Rendu au build depuis
         le planning publié (frontmatter + src/semaine.mjs) : lisible sans
         JavaScript, et rien d'écrit à la main qui puisse dériver. Même
         rail que l'histoire de la salle : les années là-haut, les heures
         ici. -->
    {heures.length > 0 && (
    <section class="section" aria-label="La salle heure par heure">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Une journée aux Minimes</span>
          <h2 class="display" style="margin-top:1rem">La salle <span class="tint">heure par heure</span></h2>
          <p class="lead" style="margin-top:1.2rem;max-width:56ch">Selon l’heure où tu pousses la porte, ce n’est pas la même salle qui t’attend. Voilà qui l’occupe, d’après le planning de la saison {SEASON}.</p>
        </div>
        <ol class="timeline">
          {heures.map((x) => (
            <li class="tl" data-reveal>
              <span class="tl__y">{x.h}</span>
              <div><h3 class="tl__t">{x.t}</h3><p class="tl__d">{x.d}</p></div>
            </li>
          ))}
        </ol>
        <p data-reveal style="margin-top:clamp(1.6rem,3vw,2.2rem)"><a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Toute la semaine, cours par cours</span></a></p>
      </div>
    </section>
    )}

    <!-- ========================= FINAL GONG ====================== -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="gong__bg" aria-hidden="true"><div class="media" data-img="/assets/img/photos/ring-cours-rouge-1200.webp" data-label=""></div></div>
      <div class="gong__inner">
        <span class="eyebrow" data-reveal>La porte</span>
        <h2 class="display" data-reveal style="font-size:var(--step-3)">Pousse la porte<br><span class="tint">des Minimes.</span></h2>
        <p class="lead" data-reveal>Le prix d’un ciné pour ta première fois sur un ring. Pousse la porte.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=44-99-4-semaines&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Je m’inscris · 44,99€</span></a><a class="btn btn--ghost" data-magnetic href="https://boutique.boxingcenter.fr/seance-essai?utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Tester une séance · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/"><span>Retour à l’accueil</span></a>
        </div>
      </div>
    </section>

  </main>

  <div id="footer"></div>
