---
import SiteContent from "../../components/SiteContent.astro";
---
<!doctype html>
<html lang="fr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mentions légales | Boxing Center Minimes</title>
  <link rel="canonical" href="https://boxe-toulouse.com/mentions-legales/" />
  <meta property="og:url" content="https://boxe-toulouse.com/mentions-legales/" />
  <meta name="description" content="Mentions légales du site Boxing Center Minimes : éditeur SAS BOXING CENTER, directeur de la publication, hébergeur et crédits photographiques." />

  <!-- Polices auto-hébergées (mêmes familles/graisses que le reste du site) -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-black-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=b56" />
  <link rel="stylesheet" href="/assets/css/base.css?v=b56" />
  <link rel="stylesheet" href="/assets/css/refonte.css?v=b56" />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0a1020" />
  <link rel="icon" href="/favicon-16.png?i=3" type="image/png" sizes="16x16" />
  <link rel="icon" href="/favicon.png?i=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-48.png?i=3" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon-96.png?i=3" type="image/png" sizes="96x96" />
  <link rel="shortcut icon" href="/favicon.png?i=3" />
  <link rel="icon" href="/favicon-192.png?i=3" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?i=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Open Graph / Twitter — pas de canonical ni d’og:url : une 404 se sert
       sur n’importe quelle URL -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Boxing Center Minimes" />
  <meta property="og:title" content="Mentions légales | Boxing Center Minimes" />
  <meta property="og:description" content="Mentions légales du site Boxing Center Minimes : éditeur SAS BOXING CENTER, directeur de la publication, hébergeur et crédits photographiques." />
  <meta property="og:image" content="https://boxe-toulouse.com/assets/img/og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Boxing Center Minimes — la salle historique, plusieurs rings, quartier Barrière de Paris à Toulouse." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Mentions légales | Boxing Center Minimes" />
  <meta name="twitter:description" content="Mentions légales du site Boxing Center Minimes : éditeur SAS BOXING CENTER, directeur de la publication, hébergeur et crédits photographiques." />
  <meta name="twitter:image" content="https://boxe-toulouse.com/assets/img/og.jpg" />

  <style is:inline>
    .nf { min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--black); }
    .nf__brand { display: flex; align-items: center; gap: .8ch; padding: clamp(1.2rem,3vw,1.8rem) var(--gut); }
    .nf__brand img { height: clamp(24px,3vw,32px); width: auto; filter: brightness(0) invert(1); }
    /* loi du navy : le nom de salle est une info, pas un décor → os, et le
       filet de gauche est en argent (même traitement que .nav__salle) */
    .nf__salle { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .2em; text-transform: uppercase; color: var(--bone); padding-left: .8ch; border-left: 2px solid var(--mark); }
    .nf__main { flex: 1; display: grid; place-items: center; text-align: center; padding: 2rem var(--gut) clamp(3rem,8vw,6rem); position: relative; }
    .nf__code { font-family: var(--f-display); text-transform: uppercase; line-height: .8; font-size: clamp(6rem,30vw,20rem); color: transparent; -webkit-text-stroke: 2px var(--line); letter-spacing: -.02em; }
    .nf__ko { display: block; font-size: clamp(2.4rem,10vw,6rem); color: var(--mark); -webkit-text-stroke: 0; margin-top: -.1em; }
    .nf__title { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.4rem,4vw,2.4rem); line-height: 1; margin: 1.4rem 0 .8rem; color: var(--bone); }
    .nf__sub { color: var(--muted); max-width: 46ch; margin: 0 auto 2rem; font-size: var(--step-0); }
    .nf__cta { display: inline-flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
    .nf__links { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; justify-content: center; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; }
    .nf__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--bone-dim); transition: color .3s; }
    .nf__links a:hover, .nf__links a:active { color: var(--white); }
  </style>
  <SiteContent />
  <style is:inline>
    .legal { max-width: 78ch; margin: 0 auto; padding: clamp(7rem, 14vw, 10rem) var(--gut) clamp(4rem, 9vw, 7rem); text-align: left; }
    .legal h1 { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1; margin: 1rem 0 1.6rem; }
    .legal h2 { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.1rem, 2.4vw, 1.5rem); margin: 2.2rem 0 .7rem; }
    .legal p { line-height: 1.65; margin: 0 0 .8rem; }
    .legal a { text-decoration: underline; text-underline-offset: .2em; }
  </style>
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="nf" style="min-height:auto">
    <a class="nf__brand" href="/" aria-label="Boxing Center Minimes — accueil">
      <img src="/assets/img/logo.png" alt="" width="342" height="160" />
      <span class="nf__salle">Minimes</span>
    </a>

    <main class="legal" id="main">
      <span class="eyebrow">Informations légales</span>
      <h1>Mentions légales</h1>
      <p>Le site boxe-toulouse.com présente le club Boxing Center Minimes, au 12 rue de Fenouillet, 31200 Toulouse.</p>

      <h2>Éditeur du site</h2>
      <p><b>SAS BOXING CENTER</b>, société par actions simplifiée au capital de 1&nbsp;500&nbsp;€,
      immatriculée au RCS de Toulouse sous le numéro 821&nbsp;817&nbsp;889 (SIREN 821&nbsp;817&nbsp;889).
      Siège social : 12 rue de Fenouillet, 31200 Toulouse. La société exploite les cinq clubs Boxing Center
      de l’agglomération toulousaine.</p>
      <p>Contact : <a href="mailto:boxingcenter31@gmail.com">boxingcenter31@gmail.com</a> ·
      <a href="tel:+33562244682">05 62 24 46 82</a>.</p>

      <h2>Directeur de la publication</h2>
      <p>Sébastien Dutilh, comme indiqué dans les
      <a href="https://boxingcenter.fr/mentions-legales/" rel="noopener">mentions légales du site du réseau</a>.</p>

      <h2>Hébergement</h2>
      <p>Vercel Inc., 440 N Barranca Avenue #4133, Covina, CA 91723, États-Unis.</p>

      <h2>Propriété des contenus</h2>
      <p>Les textes, photographies, vidéos et le logo Boxing Center présents sur ce site appartiennent à
      SAS BOXING CENTER ou à leurs auteurs. Toute reproduction ou réutilisation sans autorisation écrite
      est interdite.</p>

      <h2>Crédits photographiques</h2>
      <p>Photographies : <b>B.M Photographie</b> (séances photo des clubs Boxing Center, 2026) et
      <b>Axel Derewiany</b>. Tous droits réservés à leurs auteurs. Une personne reconnaissable sur une photo
      peut en demander le retrait à l’adresse ci-dessus.</p>

      <h2>Sources</h2>
      <p><a href="https://boxingcenter.fr/mentions-legales/" rel="noopener">Mentions légales du réseau Boxing Center</a> ·
      <a href="https://annuaire-entreprises.data.gouv.fr/entreprise/821817889" rel="noopener">Annuaire des entreprises — SIREN 821 817 889</a>.</p>
    </main>
  </div>
</body>
</html>
