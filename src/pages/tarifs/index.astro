  <!-- page-scoped : cartes d’offres, bandeau bonus, avis — squelette propre à /tarifs/ -->
  <style is:inline>
    /* l’en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : les 10€ comme OBJET PHYSIQUE. C’est
       la page du prix : elle commence par le billet, pas par un paragraphe. */
    .page-head--tar { padding-bottom: clamp(2.5rem,6vw,4rem); }
    .page-head--tar .page-head__bg { opacity: .22; }
    .tar-note { position: absolute; right: var(--gut); top: 42%; z-index: 1; display: none; width: 15rem; padding: 1rem 1.1rem; background: var(--bone); color: var(--ink); border: 1px solid var(--bone); transform: rotate(-7deg); box-shadow: 0 24px 50px rgba(0,0,0,.6); }
    @media (min-width: 1000px){ .tar-note { display: block; } }
    .tar-note::before { content: ""; position: absolute; inset: 5px; border: 1px dashed rgba(0,0,0,.35); pointer-events: none; }
    .tar-note__v { font-family: var(--f-display); font-size: 3.4rem; line-height: .8; }
    .tar-note__l { margin-top: .5rem; font: 700 .6rem/1.3 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--ink); }
    .tar-note__s { margin-top: .35rem; font: 700 .55rem/1.3 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--on-bone-dim); }

    .tar-head__meta { display: flex; flex-wrap: wrap; gap: .7rem 2rem; margin-top: 1.4rem; font: 700 var(--step--1)/1.5 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone-dim); }
    /* prices/data must be legible — bone (17:1), not 4:1 red */
    .tar-head__meta b { color: var(--bone); font-weight: 700; }

    /* offer cards — plus élevé que le teaser accueil */
    .offers { display: grid; gap: .7rem; grid-template-columns: 1fr; margin-top: 0; }
    @media (min-width: 680px){ .offers { grid-template-columns: repeat(2,1fr); } }
    @media (min-width: 1120px){ .offers { grid-template-columns: repeat(4,1fr); } }
    /* ⚠ INVERSION v4 : la carte etait un aplat SOMBRE et la carte mise en
       avant un aplat CLAIR. Les deux tokens ayant change de camp, la regle
       d origine posait du navy sur du navy (1.02:1) — les quatre cartes de
       tarifs etaient litteralement illisibles. Carte blanche par defaut,
       aplat navy pour la mise en avant. */
    .offer { position: relative; display: flex; flex-direction: column; gap: 1.1rem; padding: clamp(1.6rem,3vw,2.3rem); background: var(--paper); color: var(--on-light); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out); }
    .offer::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--mark); transform: scaleY(0); transform-origin: bottom; transition: transform .5s var(--ease-out); }
    .offer:hover, .offer:active { transform: translateY(-5px); box-shadow: var(--shadow-md); }
    .offer:hover::before, .offer:active::before { transform: scaleY(1); }
    .offer--hot { background: var(--navy-600); color: #fff; border-color: var(--navy-600); box-shadow: var(--shadow-lg);
      --bone:#fff; --read:#DCDDEE; --bone-dim:var(--navy-200); --mark:#fff; --steel:var(--navy-200); }
    .offer--hot::before { background: #fff; }
    .offer__tag { align-self: flex-start; font: 700 var(--step--2)/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: #fff; background: var(--rust-400); padding: .5em .9em; border: 0; border-radius: 100px; }
    .offer--hot .offer__tag { color: var(--navy-600); background: #fff; }
    .offer__name { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.35rem,2.6vw,1.9rem); line-height: .95; color: inherit; }
    .offer__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5ch; }
    .offer__was { font: 700 1rem/1 var(--f-mono); color: var(--bone-dim); text-decoration: line-through; text-decoration-color: var(--mark); }
    .offer--hot .offer__was { color: var(--navy-200); }
    .offer__now { font-family: var(--f-display); font-size: clamp(2.8rem,6.5vw,4rem); line-height: .8; color: var(--bone); letter-spacing: -.02em; }
    .offer__unit { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--bone); }
    .offer--hot .offer__unit { color: #fff; }
    .offer__period { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--bone-dim); width: 100%; }
    .offer--hot .offer__period { color: var(--navy-200); }
    .offer__feature { font-size: var(--step--1); font-weight: 600; color: var(--bone); }
    .offer--hot .offer__feature { color: #fff; }
    .offer__items { display: grid; gap: .55rem; margin-top: auto; }
    .offer__items li { display: flex; gap: .8ch; align-items: flex-start; font-size: var(--step--1); color: var(--read); }
    .offer--hot .offer__items li { color: #DCDDEE; }
    .offer__items li::before { content: ""; flex: 0 0 7px; height: 7px; margin-top: .5em; background: var(--mark); }
    .offer .btn { margin-top: .4rem; }

    /* bonus */
    /* Bandeau d appui : c est un APLAT navy assume, pas un degrade fantome
       qui virait au gris sale sur fond blanc. */
    .bonus { position: relative; margin-top: clamp(1.6rem,4vw,2.4rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; padding: clamp(1.5rem,3vw,2.1rem) clamp(1.5rem,3vw,2.3rem); border: 0; border-radius: var(--radius-lg); background: var(--navy-600); color: #fff;
      --bone:#fff; --mark:#fff; }
    .bonus__badge { font: 700 var(--step--2)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--navy-600); background: #fff; border: 0; border-radius: 100px; padding: .6em 1em; }
    .bonus__txt { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.1rem,2.6vw,1.7rem); line-height: 1.05; color: var(--bone); }
    .bonus__txt b { color: var(--white); }

    /* réassurance / avis */
    .rev-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.6rem,4vw,2.4rem); }
    .rev-rating { display: inline-flex; align-items: baseline; gap: .6ch; }
    .rev-rating__v { font-family: var(--f-display); font-size: clamp(2.4rem,5vw,3.4rem); line-height: .85; color: var(--bone); }
    .rev-rating__v small { font-size: .34em; color: var(--bone-dim); }
    .rev-rating__src { font: 700 var(--step--1)/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--bone); }
    .reviews { display: grid; gap: .7rem; grid-template-columns: 1fr; }
    @media (min-width: 760px){ .reviews { grid-template-columns: repeat(3,1fr); } }
    .review { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.5rem,3vw,2.1rem); background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); transition: box-shadow .4s, transform .45s var(--ease-out); }
    .review:hover, .review:active { box-shadow: var(--shadow-md); transform: translateY(-4px); }
    /* L'or des étoiles doit rester lisible SUR BLANC : le #F5A623 des
       interfaces d'avis mesure 2.03:1 sur papier — acceptable pour un
       pictogramme, insuffisant dès qu'il porte l'information. Le degré
       retenu tient 4:1 et se lit toujours comme de l'or. */
    .review__stars { color: #A66500; letter-spacing: .25em; font-size: .95rem; }
    .review__text { color: var(--bone); font-size: var(--step-0); line-height: 1.5; }
    .review__author { margin-top: auto; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--bone-dim); }
    .review__author::before { content: "— "; color: var(--mark); }
  </style>

  <script is:inline>
    document.documentElement.classList.add('fx');
    (function () {
