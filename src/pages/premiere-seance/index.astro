  <!-- page-scoped : le déroulé numéroté, la liste du sac, la note de prix.
       Tout le reste (en-tête, sections, cartes « ask », gong) est repris
       tel quel de base.css et club.css — une page de plus ne justifie pas
       une deuxième façon de dessiner un titre. -->
  <style is:inline>
    /* Le déroulé : un numéro qui tient la colonne, le texte à côté. Sur
       mobile le numéro passe AU-DESSUS — à 320px, une colonne de chiffres
       plus une colonne de texte, c’est deux mots par ligne. */
    .pas { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
    /* v4 : cette carte etait un aplat SOMBRE sur une page sombre. La page
       est devenue claire, ses encres aussi — la carte doit suivre, sinon
       elle porte du texte navy sur du navy. Carte blanche + filet. */
    .pas__step { background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: clamp(1.5rem,3.4vw,2.4rem); display: grid; gap: .5rem 1.6rem; grid-template-columns: 1fr; border-left: 2px solid transparent; transition: background .35s, border-color .35s; }
    .pas__step:hover { box-shadow: var(--shadow-md); border-left-color: var(--mark); }
    .pas__n { font-family: var(--f-mono); font-weight: 700; font-size: var(--step--1); letter-spacing: .18em; color: var(--mark); }
    .pas__t { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.25rem,3vw,1.9rem); line-height: 1.02; color: var(--bone); margin-bottom: .5rem; }
    .pas__d { color: var(--read); line-height: 1.6; max-width: 62ch; }
    .pas__d b { color: var(--bone); font-weight: 600; }
    @media (min-width: 760px) {
      .pas__step { grid-template-columns: 4.5rem 1fr; }
      .pas__n { font-size: clamp(1.6rem,2.4vw,2.2rem); font-family: var(--f-display); letter-spacing: 0; line-height: 1; }
    }
    /* Le sac : une case à cocher dessinée, pas une puce de traitement de texte */
    .sac { display: grid; gap: 0; margin-top: clamp(1.4rem,3vw,2rem); }
    .sac li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding-block: clamp(.9rem,2vw,1.15rem); border-bottom: 1px solid var(--line); color: var(--read); line-height: 1.55; }
    .sac li:first-child { border-top: 1px solid var(--line); }
    .sac li::before { content: ""; width: 14px; height: 14px; margin-top: .42em; border: 2px solid var(--mark); flex: 0 0 14px; }
    .sac b { color: var(--bone); font-weight: 600; }
    /* La note de prix : le chiffre à l’échelle du display, la suite en clair */
    .prix-note { border: 1px solid var(--line); padding: clamp(1.6rem,4vw,2.6rem); display: grid; gap: 1.2rem; }
    .prix-note__v { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2.8rem,9vw,5.4rem); line-height: .85; color: var(--bone); }
    .prix-note__cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: .4rem; }
    @media (min-width: 900px) { .prix-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem,4vw,3.4rem); align-items: start; } }
  </style>

