  <div class="cursor__dot" aria-hidden="true"></div>

  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ======================== 01 · HERO ==========================
         L'animation « pochoir » de v3 est CONSERVÉE (hero.js la pilote :
         vidéo découpée dans le lettrage, bascule pochoir/plein, canvas).
         Ce qui change ici, c'est ce qu'il y a AUTOUR : une promesse qui
         parle du visiteur et non de la salle, la note Google enfin
         visible, et deux boutons dont le libellé correspond à la page
         où ils mènent. -->
    <header class="hero" data-hero="a" data-surface="deep" aria-label="Boxing Center Minimes">
      <div class="hero__stage" aria-hidden="true">
        <video id="hero-video" class="hero__src" data-video="/assets/media/hero-minimes.mp4" data-video-mobile="/assets/media/hero-minimes-mobile.mp4" data-poster="/assets/img/photos/hero-minimes-poster.webp" muted autoplay playsinline preload="auto"></video>
        <div class="hero-a__knock">
          <div class="hero__word">
            <span class="hero__word-top" data-split>Boxing</span>
            <span class="hero__word-mid" data-split>Center</span>
            <span class="hero__word-main" data-split>Minimes</span>
          </div>
        </div>
        <canvas id="hero-canvas" class="hero-b__canvas"></canvas>
        <div class="hero__word hero__word--solid">
          <span class="hero__word-top" data-split>Boxing</span>
            <span class="hero__word-mid" data-split>Center</span>
          <span class="hero__word-main" data-split>Minimes</span>
        </div>
        <div class="vignette-local"></div>
      </div>

      <h1 class="sr-only">Salle de boxe à Toulouse Minimes — Boxing Center, cours de boxe anglaise tous niveaux</h1>

      <div class="hero__inner">
        <p class="hero__kicker" data-reveal>Salle de boxe · Toulouse Minimes · Barrière de Paris</p>
        <p class="hero__sub" data-reveal>Apprenez à boxer, quel que soit votre niveau.<br><b>Le premier cours suffit à comprendre pourquoi on revient.</b></p>
        <div class="hero__cta" data-reveal>
          <a class="btn btn--primary btn--lg" data-magnetic data-cursor="go" href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-minimes"><span>Je profite de l’offre à 29€</span></a>
        </div>
        <p class="hero__proof" data-reveal>
          <span class="rating rating--hero" data-rating="4.3" data-rating-count="156"></span>
          <span class="hero__proof-sep" aria-hidden="true">·</span>
          <span class="hero__proof-txt">Gants et matériel prêtés</span>
        </p>
      </div>

      <button class="hero-toggle" id="hero-toggle" type="button" aria-pressed="false">Vue : <span>Pochoir</span> <i aria-hidden="true">⇄</i></button>

      <div class="hero__foot" aria-hidden="true">
        <span class="scroll-cue">Découvrir la salle <span class="line"></span></span>
        <span class="hero__round" id="hero-round"><b class="hero__round-k">Round</b> <span id="hero-round-n">01</span><i id="hero-round-t">/07</i></span>
      </div>
    </header>

    <!-- ==================== 02 · RÉASSURANCE ======================
         Les quatre objections qui font fermer l'onglet — « c'est cher »,
         « je vais m'engager », « je n'ai pas de matériel », « c'est
         loin » — répondues au-dessus de la ligne de flottaison, avant
         qu'elles ne se formulent. -->
    <section class="trustbar" data-surface="paper" aria-label="Pourquoi essayer ici">
      <div class="trustbar__grid">
        <!-- La case la plus a gauche est la premiere lue de la barre : elle
             porte l'OFFRE, pas la note. La note Google n'est pas perdue pour
             autant — elle reste dans le hero, juste au-dessus, et en tete de
             la section des avis. Seule case cliquable de la barre : un prix
             sans moyen d'agir dessus est une occasion manquee. -->
        <a class="trustbar__item trustbar__item--offre" href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=trustbar&utm_campaign=bc-minimes"><span class="trustbar__k"><s class="trustbar__was">44€</s>29€</span><span class="trustbar__v">L’offre rentrée · 4 semaines</span></a>
        <!-- La deuxieme case porte la SECONDE offre phare, pour que les deux
             tarifs qui font vivre le club se lisent cote a cote, comme dans la
             roulette. La seance d'essai a 10 EUR n'est pas perdue : elle reste
             dans le hero (second bouton), sur la page tarifs et dans le gong. -->
        <a class="trustbar__item trustbar__item--offre" href="https://boutique.boxingcenter.fr/offre/259?utm_source=site&utm_medium=trustbar&utm_campaign=bc-minimes"><span class="trustbar__k"><s class="trustbar__was">400€</s>259€</span><span class="trustbar__v">La saison · 4× sans frais</span></a>
        <!-- La phrase demandee est portee par les DEUX lignes de la case : le
             gros caractere dit le niveau requis (aucun), la ligne du dessous
             dit jusqu'ou ca va. Ecrite d'un seul tenant dans le petit libelle,
             elle passait a trois lignes et cassait l'alignement des quatre
             cases. -->
        <div class="trustbar__item trustbar__item--large"><span class="trustbar__k">Tous niveaux</span><span class="trustbar__v">Du débutant au boxeur professionnel</span></div>
        <div class="trustbar__item"><span class="trustbar__k">3 min</span><span class="trustbar__v">Du métro ligne B</span></div>
      </div>
    </section>

    <!-- ============ 03 · SPLIT — LA SALLE (photo à gauche) ========= -->
    <section class="split-sec split-sec--bleed" data-surface="paper" data-round="1" data-round-name="La salle" aria-labelledby="t-salle">
      <div class="split-sec__grid">
        <div class="split-sec__media reveal-media">
          <img src="/assets/img/photos/salle-plongee-1200.webp"
               srcset="/assets/img/photos/salle-plongee-700.webp 700w, /assets/img/photos/salle-plongee-1200.webp 1200w, /assets/img/photos/salle-plongee.webp 2000w"
               sizes="(min-width: 940px) 46vw, 92vw"
               alt="Vue plongeante sur la salle de boxe des Minimes : le tapis central, les sacs de frappe alignés et la charpente en verrière" width="1200" height="798" loading="lazy" decoding="async" />
          <span class="split-sec__tag"><b>500</b> m² de plateau</span>
        </div>
        <div class="split-sec__body reveal-up">
          <span class="eyebrow">La salle</span>
          <h2 id="t-salle" class="display display--sm">Une vraie salle de boxe.<br>Pas un plateau de <span class="tint">fitness.</span></h2>
          <p class="lead">Plusieurs rings de compétition, douze sacs, un étage entier pour la préparation physique : vous vous entraînez dans les conditions qui ont formé plus de 8 boxeurs professionnels.</p>
          <p>Ouverte en 2016, la salle des Minimes est la première du réseau Boxing Center. On y vient pour apprendre le geste juste, pas pour poser devant un miroir — et c’est exactement ce qui rend le premier cours si simple à passer.</p>
          <ul class="benefits">
            <li><b>Plusieurs rings</b> — de quoi travailler en petits groupes, sans attendre son tour</li>
            <li><b>Douze sacs et un plateau de force</b> — technique et physique dans la même séance</li>
            <li><b>Matériel prêté</b> — gants, casques et protections fournis le temps de vous équiper</li>
          </ul>
          <div class="btn-row">
            <a class="btn btn--ghost" data-magnetic href="/le-club/"><span>Visiter la salle</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== 04 · LES CHIFFRES (bande navy) ============== -->
    <section class="section section--tight" data-surface="navy" aria-label="Le club en chiffres">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Le club en chiffres</span>
        <div class="stats" id="stats" data-reveal-group style="margin-top:clamp(2rem,4vw,3rem)"></div>
      </div>
    </section>

    <!-- ========== 05 · SPLIT — L'ENCADREMENT (photo à droite) ====== -->
    <section class="split-sec" data-surface="paper" data-round="2" data-round-name="L’encadrement" aria-labelledby="t-coach">
