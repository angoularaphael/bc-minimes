         case affichee. Montee par site.js > mountPromoWheels(). -->
    <div class="wrap" data-promo></div>


    <!-- ========================= LE POSTER ========================
         §5.5 : EN COULEUR, cliquable plein format, width/height posées.
         ⚠ Le PNG de 2 033 Ko était servi en fetchpriority="high" — le
         plus gros téléchargement de la page, poussé en tête de file, sur
         la page qu’un parent ouvre en premier — alors que le webp (97 Ko,
         21× plus léger) dormait dans le même dossier. -->
    <section class="section section--flush" aria-label="Le poster officiel">
