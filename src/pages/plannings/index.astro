  <!-- page-scoped : la semaine comme OBJET — le rail des jours dans l’en-tête,
       le poster en couleur, puis la grille filtrable. Le poster reste
       l’artefact ; la grille est ce qui rend la page utilisable. -->
  <style is:inline>
    /* --- en-tête : le rail de la semaine (structure propre à cette page) ---
       Devenu CLIQUABLE : c’était déjà la forme de la semaine, il lui
       manquait d’être le raccourci qu’on croit qu’il est. ≥44px de haut. */
    .pl-week { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: clamp(1.4rem,3vw,2rem); }
    /* fond noir ecrit en dur (v3) : illisible sur la page claire. */
    .pl-week__d { display: inline-flex; flex-direction: column; gap: .45rem; min-width: 3.4rem; min-height: 44px; padding: .6rem .7rem; border: 1px solid var(--hair); border-radius: var(--radius); background: var(--paper-2); text-align: left; transition: border-color .3s, background .3s; }
    .pl-week__d:hover, .pl-week__d:active { border-color: var(--mark); background: rgba(38,64,115,.45); }
    .pl-week__n { font: 700 .62rem/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone); }
    .pl-week__bar { display: flex; flex-wrap: wrap; gap: 2px; min-height: 10px; }
    .pl-week__bar i { width: 4px; height: 10px; background: var(--mark); }
    /* barres et compte sont écrits par le filtre : un jour que le filtre
       vide s’éteint au lieu de mentir sur une semaine qu’on ne voit plus */
    .pl-week__d.is-empty { opacity: .45; }
    .pl-week__d[aria-pressed="true"] { border-color: var(--mark); background: rgba(38,64,115,.55); }
    .pl-week__c { display: flex; flex-direction: column; gap: .22rem; font: 700 .58rem/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone-dim); }
    .pl-week__f { opacity: .68; }

    /* --- le repère « en ce moment » — calculé à l’exécution, jamais écrit
       dans le markup (une heure en dur, c’est une page fausse à 21h). --- */
    .pl-now { display: inline-flex; align-items: center; gap: .8ch; margin-top: 1.2rem; padding: .7em 1em; border: 1px solid var(--line); border-left: 3px solid var(--mark); background: rgba(10,16,32,.6); font: 500 var(--step--1)/1.4 var(--f-mono); letter-spacing: .04em; color: var(--read); }
    .pl-now b { color: var(--bone); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .pl-now:empty { display: none; }

    .pl-meta { display: flex; flex-wrap: wrap; gap: .7rem 2rem; margin-top: 1rem; font: 700 var(--step--1)/1.5 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--bone-dim); }
    /* days/hours are real info → legible bone, not 4:1 red */
    .pl-meta b { color: var(--bone); font-weight: 700; }

    /* --- le poster : EN COULEUR (§5.5), cliquable, dimensions posées --- */
    .pl-poster { display: block; position: relative; border: 1px solid var(--line); }
    .pl-poster img { width: 100%; height: auto; display: block; }
    .pl-poster::after { content: "Ouvrir en grand ↗"; position: absolute; right: .9rem; bottom: .9rem; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: #fff; background: var(--navy-600); padding: .6em .9em; border: 0; border-radius: 100px; }
    .pl-poster:hover::after, .pl-poster:active::after { color: var(--on-accent); background: var(--navy); border-color: var(--silver); }

    /* --- filtres jour / discipline / coach (§3) --- */
    .pl-filters { display: grid; gap: .9rem; margin-bottom: clamp(1.2rem,3vw,1.8rem); }
    .pl-fgroup { display: grid; gap: .5rem; }
    .pl-fgroup__l { display: inline-flex; align-items: center; gap: .7ch; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--bone); }
    .pl-fgroup__l::before { content: ""; width: 18px; height: 2px; background: var(--mark); flex: 0 0 18px; }
    .pl-fgroup__row { display: flex; flex-wrap: wrap; gap: .4rem; }
    .pl-chip { display: inline-flex; align-items: center; min-height: 44px; padding: .5em .9em; border: 1px solid var(--line); font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--bone-dim); transition: color .3s, border-color .3s, background .3s; }
    .pl-chip:hover, .pl-chip:focus-visible { color: var(--bone); border-color: var(--bone-dim); }
    /* actif = blanc sur aplat navy (14.6:1) — le filet de contour est en argent */
    .pl-chip.is-on, .pl-chip:active { color: var(--on-accent); background: var(--navy); border-color: var(--silver); }

    .pl-countrow { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin-bottom: clamp(1.2rem,3vw,1.6rem); }
    .pl-count { font: 700 var(--step--1)/1.4 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); border-left: 2px solid var(--mark); padding-left: .8rem; }
    /* n’apparaît que quand un filtre est posé (JS gère `hidden`) */
    .pl-reset { display: inline-flex; align-items: center; gap: .7ch; min-height: 44px; padding: .4em .9em; border: 1px solid var(--line); font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone-dim); transition: color .3s, border-color .3s; }
    .pl-reset:hover, .pl-reset:active { color: var(--bone); border-color: var(--bone-dim); }
    .pl-reset[hidden] { display: none; }

    /* --- la grille : 6 colonnes-jour au bureau, empilée au téléphone --- */
    .pl-grid { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
    @media (min-width: 700px){ .pl-grid { grid-template-columns: repeat(2,1fr); } }
    @media (min-width: 1100px){ .pl-grid { grid-template-columns: repeat(6,1fr); } }
    /* v4 : cette carte etait un aplat SOMBRE sur une page sombre. La page
       est devenue claire, ses encres aussi — la carte doit suivre, sinon
       elle porte du texte navy sur du navy. Carte blanche + filet. */
    .pl-day { background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: clamp(1rem,2vw,1.2rem); display: flex; flex-direction: column; gap: .7rem; }
    .pl-day.is-hidden { display: none; }
    .pl-day__h { display: flex; align-items: baseline; justify-content: space-between; gap: .6ch; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.05rem,2vw,1.3rem); line-height: 1; color: var(--bone); border-bottom: 2px solid var(--mark); padding-bottom: .55rem; }
    .pl-day__h i { font: 700 .62rem/1 var(--f-mono); font-style: normal; color: var(--bone-dim); }
    .pl-day__list { display: grid; gap: .5rem; }
    .pl-slot { display: grid; gap: .18rem; padding: .6rem .65rem; background: var(--paper-2); border-left: 2px solid var(--hair); transition: border-color .3s, background .3s; }
    .pl-slot:hover, .pl-slot:active { border-left-color: var(--mark); background: var(--char); }
    .pl-slot.is-hidden { display: none; }
    .pl-slot__h { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .06em; color: var(--bone); }
    .pl-slot__h i { font-style: normal; color: var(--bone-dim); }
    .pl-slot__n { font-size: .84rem; line-height: 1.3; color: var(--read); }
    .pl-slot__m { font: 500 .68rem/1.3 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--bone-dim); }
    .pl-slot__m b { color: var(--bone); font-weight: 700; }

    /* ACCÈS LIBRE — la moitié du poster. Visuellement en RETRAIT (pas de
       coach, pas d’aplat) sans être illisible : le texte reste à --read
       (~14:1), seul le fond et le filet changent. Un créneau libre n’est
       pas un créneau mort, c’est juste un créneau sans encadrement. */
    .pl-slot--free { background: transparent; border-left: 2px dashed var(--line); }
    .pl-slot--free .pl-slot__n { color: var(--bone-dim); }
    .pl-slot--free:hover, .pl-slot--free:active { background: var(--paper-3); border-left-color: var(--mark); }

    /* « en ce moment » / « juste après » — repères vivants, calculés au
       chargement. L’aplat navy porte le blanc (14.6:1), jamais l’inverse. */
    .pl-slot.is-now { background: var(--navy); border-left-color: var(--silver); }
    .pl-slot.is-now .pl-slot__h, .pl-slot.is-now .pl-slot__n,
    .pl-slot.is-now .pl-slot__m, .pl-slot.is-now .pl-slot__m b,
    .pl-slot.is-now .pl-slot__h i { color: var(--on-accent); }
    .pl-slot.is-next { border-left-color: var(--mark); background: var(--char); }
    .pl-slot.is-next .pl-slot__h::after { content: " · à suivre"; color: var(--bone-dim); font-weight: 500; }
    .pl-day__empty { display: none; font: 500 .7rem/1.4 var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--bone-dim); }
    .pl-day.is-empty .pl-day__empty { display: block; }
  </style>

  <!-- fx + DEAD-MAN NET (§5.1) : `fx` force [data-reveal] à opacity:0.
       Si un module casse avant window.BC.reveal() — import raté, erreur
       runtime — le texte reste invisible POUR TOUJOURS. Le filet le retire
       de force ; le moteur de reveal re-masquera seulement ce qu’il a
       réellement bindé. Une animation ne doit jamais pouvoir bloquer du texte. -->
  <script is:inline>
    document.documentElement.classList.add('fx');
    (function () {
      var off = function () { document.documentElement.classList.remove('fx'); };
      setTimeout(off, 2500);
      addEventListener('error', off);
      addEventListener('unhandledrejection', off);
    })();
  </script>
