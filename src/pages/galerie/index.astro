  <!-- page-scoped : mosaïque N&B (mur de champion), filtres par zone, lightbox -->
  <style is:inline>
    /* l’en-tête partage .page-head (base.css) — la répétition est honnête.
       Ce qui appartient à CETTE page : le bord de planche-contact, les
       perforations d’un film. C’est la page des images : elle commence par
       le bord d’une pellicule. */
    .page-head--ga .page-head__bg { opacity: .22; }
    .ga-sprockets { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; display: flex; gap: 10px; padding: 7px 0; background: var(--black); border-top: 1px solid var(--line); overflow: hidden; pointer-events: none; }
    .ga-sprockets i { flex: 0 0 26px; height: 14px; border-radius: 2px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.2); }
    .ga-sprockets i:nth-child(4n) { background: var(--navy-2); }

    /* filtres par zone */
    .ga-filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: clamp(1.4rem,3vw,2rem); }
    .ga-filter { display: inline-flex; align-items: center; min-height: 44px; padding: .55em .95em; border: 1px solid var(--line); font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone-dim); transition: color .3s, border-color .3s, background .3s; }
    .ga-filter:hover { color: var(--bone); border-color: var(--bone-dim); }
    .ga-filter:active, .ga-filter.is-on { color: var(--on-accent); background: var(--navy); border-color: var(--silver); }
    /* le compte par zone — dérivé des photos (galerie.js). Un filtre qui
       annonce combien il en reste évite le clic dans le vide. */
    .ga-filter i { font-style: normal; margin-left: .8ch; padding-left: .8ch; border-left: 1px solid currentColor; opacity: .7; }

    /* --- le pont galerie → disciplines : la page ne s’arrête plus à la
       mosaïque, chaque zone photo mène au cours correspondant --- */
    .ga-bridge { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
    @media (min-width: 640px){ .ga-bridge { grid-template-columns: repeat(2,1fr); } }
    @media (min-width: 1020px){ .ga-bridge { grid-template-columns: repeat(4,1fr); } }
    /* v4 : cette carte etait un aplat SOMBRE sur une page sombre. La page
       est devenue claire, ses encres aussi — la carte doit suivre, sinon
       elle porte du texte navy sur du navy. Carte blanche + filet. */
    .ga-bridge__card { background: var(--paper); border: 1px solid var(--hair); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: clamp(1.3rem,2.6vw,1.8rem); min-height: 12rem; display: flex; flex-direction: column; gap: .5rem; border-top: 2px solid transparent; transition: background .35s, border-color .35s; }
    .ga-bridge__card:hover, .ga-bridge__card:active { box-shadow: var(--shadow-md); border-top-color: var(--mark); }
    .ga-bridge__z { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone-dim); }
    .ga-bridge__n { font-family: var(--f-display); text-transform: uppercase; font-size: var(--step-1); line-height: .95; color: var(--bone); }
    .ga-bridge__d { font-size: var(--step--1); line-height: 1.5; color: var(--muted); }
    .ga-bridge__go { margin-top: auto; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bone); border-top: 2px solid var(--mark); padding-top: .8rem; transition: color .3s; }
    .ga-bridge__card:hover .ga-bridge__go { color: var(--white); }

    /* mosaïque */
    .ga-grid { display: grid; gap: .6rem; grid-template-columns: repeat(2,1fr); grid-auto-flow: dense; }
    @media (min-width: 760px){ .ga-grid { grid-template-columns: repeat(4,1fr); } }
    .ga-cell { aspect-ratio: 1; position: relative; overflow: hidden; cursor: pointer; outline-offset: -2px; }
    .ga-cell--big { grid-column: span 2; grid-row: span 2; }
    .ga-cell.is-hidden { display: none; }
    .ga-cell img { object-position: 50% 35%; transition: transform 1s var(--ease-out), filter .6s; }
    .ga-cell:hover img, .ga-cell:active img { transform: scale(1.07); filter: grayscale(1) contrast(1.05) brightness(1); }
    .ga-cell:hover, .ga-cell:focus-visible { outline: 2px solid var(--mark); }
    .ga-cell.media::after { opacity: 0; transform: translateY(10px); transition: opacity .4s, transform .5s var(--ease-out); }
    .ga-cell.media:hover::after, .ga-cell.media:focus-visible::after { opacity: 1; transform: none; }
    .ga-cell::before { content: "⤢"; position: absolute; top: .7rem; right: .8rem; z-index: 3; font-size: 1rem; color: var(--bone); opacity: 0; transform: scale(.8); transition: opacity .35s, transform .35s var(--ease-punch); }
    .ga-cell:hover::before, .ga-cell:focus-visible::before { opacity: .9; transform: scale(1); }
    /* touch : sans hover, ni la légende ni le ⤢ n’apparaissaient jamais
       (§3 « captions mono », §5.4 touch-life). Même loi que .disc. */
    @media (hover: none), (max-width: 820px){
      .ga-cell.media::after { opacity: 1; transform: none; }
      .ga-cell::before { opacity: .9; transform: scale(1); }
    }

    /* lightbox */
    /* ⚠ visibility se transitionne de façon DISCRÈTE : avec `visibility .4s`
       la valeur ne bascule qu’à 50 % (200 ms) — un .focus() immédiat tombait
       alors sur un élément encore hidden et ne faisait rien. Motif correct :
       0s à l’ouverture, différé à la fermeture (masquer APRÈS le fondu). */
    .ga-lightbox { position: fixed; inset: 0; z-index: 9200; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: clamp(1.2rem,4vw,3rem); background: rgba(0,0,0,.92); opacity: 0; visibility: hidden; transition: opacity .4s var(--ease), visibility 0s linear .4s; }
    .ga-lightbox.is-open { opacity: 1; visibility: visible; transition: opacity .4s var(--ease), visibility 0s linear 0s; }
    .ga-lb__img { max-width: min(94vw,1100px); max-height: 80vh; width: auto; height: auto; border: 1px solid var(--line); filter: grayscale(1) contrast(1.1) brightness(.95); }
    .ga-lb__cap { font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--bone); }
    .ga-lb__cap::before { content: "— "; color: var(--mark); }
    .ga-lb__close { position: absolute; top: clamp(1rem,3vw,1.8rem); right: clamp(1rem,3vw,1.8rem); display: inline-flex; align-items: center; justify-content: center; gap: .7ch; min-height: 44px; font: 700 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--bone); border: 1px solid var(--line); padding: .7em 1em; transition: color .3s, background .3s, border-color .3s; }
    .ga-lb__close:hover, .ga-lb__close:active { color: var(--on-accent); background: var(--navy); border-color: var(--silver); }
  </style>

